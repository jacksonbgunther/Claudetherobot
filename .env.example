# ClaudeTheRobot — environment variables reference
#
# This file documents what's needed. It is NOT where real secrets go —
# never fill this in and commit it. Real values are set as environment
# variables on the Claude Code environment itself (Configure cloud
# environments > Environment variables), so they persist across ephemeral
# session containers and scheduled Routines. See:
# https://code.claude.com/docs/en/cloud-environments#set-environment-variables
#
# Until a variable below is set, its corresponding skill
# (.claude/skills/<name>/SKILL.md) treats the capability as unavailable
# and says so — it does not pretend the integration works.

# --- Tier 1: publishing ---
# Buffer API token (developers.buffer.com). Covers Instagram, TikTok, and
# YouTube for this account only — NOT X or Threads (not linked in Buffer).
BUFFER_API_KEY=

# X (Twitter) API v2, direct — Buffer doesn't cover this platform here.
# From developer.x.com after creating a Project + App. OAuth 1.0a.
# Pay-per-use billing (~$0.015/post), needs a payment method on file.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Threads API, direct — also not covered by Buffer here. From
# developers.facebook.com, Threads API use case, added as a tester on the
# app (skips Meta App Review for single-account use). Free.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- Tier 2: media generation ---
# Google AI Studio / Gemini API key (aistudio.google.com/apikey), used for
# image generation (Imagen). Pay-as-you-go once past any free quota.
GEMINI_API_KEY=

# --- Tier 2, optional, not urgent (see TOOL_STACK.md) ---
# Shotstack API key — only needed once actually assembling video.
SHOTSTACK_API_KEY=
# ElevenLabs API key — only needed once actually producing narrated audio.
ELEVENLABS_API_KEY=
